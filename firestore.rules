rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasAuthEmail() {
      return isSignedIn() && request.auth.token.email is string && request.auth.token.email.size() > 0;
    }

    function isBookingOwner() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function isExistingBookingOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isIsoDate(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidBookingIdentityFields() {
      return (
        !request.resource.data.keys().hasAny(['userEmail'])
        || (
          hasAuthEmail()
          && request.resource.data.userEmail is string
          && request.resource.data.userEmail == request.auth.token.email
        )
      )
      && (
        !request.resource.data.keys().hasAny(['name'])
        || (
          request.resource.data.name is string
          && request.resource.data.name.size() > 0
        )
      )
      && (
        !request.resource.data.keys().hasAny(['email'])
        || (
          hasAuthEmail()
          && request.resource.data.email is string
          && request.resource.data.email == request.auth.token.email
        )
      );
    }

    function isValidModernBookingPayload() {
      return request.resource.data.keys().hasOnly([
          'userId',
          'activityId',
          'activityTitle',
          'travelDate',
          'travelers',
          'status',
          'createdAt',
          'userEmail',
          'name',
          'email',
          'date'
        ])
        && request.resource.data.activityId is string
        && request.resource.data.activityId.size() > 0
        && request.resource.data.activityTitle is string
        && request.resource.data.activityTitle.size() > 0
        && isIsoDate(request.resource.data.travelDate)
        && request.resource.data.travelers is int
        && request.resource.data.travelers >= 1
        && request.resource.data.travelers <= 12
        && request.resource.data.status in ['pending', 'confirmed', 'cancelled']
        && request.resource.data.createdAt is timestamp
        && (
          !request.resource.data.keys().hasAny(['date'])
          || (
            isIsoDate(request.resource.data.date)
            && request.resource.data.date == request.resource.data.travelDate
          )
        )
        && isValidBookingIdentityFields();
    }

    function isValidLegacyBookingPayload() {
      return request.resource.data.keys().hasOnly([
          'userId',
          'userEmail',
          'name',
          'email',
          'date',
          'status',
          'createdAt'
        ])
        && isIsoDate(request.resource.data.date)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && hasAuthEmail()
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && hasAuthEmail()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.createdAt is timestamp;

      allow delete: if false;
    }

    match /activities/{activityId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          'title',
          'description',
          'location',
          'category',
          'imageUrl',
          'popularity',
          'rating',
          'duration',
          'bestSeason',
          'priceRange',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'title',
          'description',
          'location',
          'category',
          'imageUrl',
          'price',
          'popularity',
          'rating',
          'duration',
          'bestSeason',
          'priceRange',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.location is string
        && request.resource.data.category is string
        && request.resource.data.imageUrl is string
        && request.resource.data.popularity is number
        && request.resource.data.rating is number
        && request.resource.data.duration is string
        && request.resource.data.bestSeason is string
        && request.resource.data.priceRange is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          !request.resource.data.keys().hasAny(['price'])
          || (request.resource.data.price is number && request.resource.data.price >= 0)
        );

      allow update, delete: if false;
    }

    match /bookings/{bookingId} {
      allow create: if isBookingOwner()
        && (isValidModernBookingPayload() || isValidLegacyBookingPayload());

      allow read: if isExistingBookingOwner();

      allow update, delete: if false;
    }
  }
}
